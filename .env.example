# Optimism FastAPI — environment configuration
# Copy to `.env` for local development. Never commit real secrets.
# All values are read at application startup via app.core.config.Settings.

# --- Database ---
DATABASE_URL=postgresql+psycopg://optimism:optimism@localhost:5432/optimism

# --- Admin authentication (shared credential, ADR-005) ---
# bcrypt hash (cost 12) of the shared admin password. The default below is the
# DEV-ONLY hash of "change-me" (matches the code default) so a verbatim copy of
# this file works; generate a real hash for any other password with:
#   make hash
ADMIN_PASSWORD_HASH=$2b$12$.U8i3Rf76NvC9ZT3ZPFu7.Hn7SbUKcjHwoun6hSajUmLBJUtUFeAS
# Secret used to sign the session cookie (>= 32 random bytes, base64).
SESSION_SECRET=replace-with-a-long-random-secret

# --- Public site / email ---
OPTIMISM_WEBSITE_BASE_URL=http://localhost:8000
OPTIMISM_EMAIL_ORG_FROM_ADDR=booking@example.org
OPTIMISM_EMAIL_ORG_NOTIFY_ADDR=organisers@example.org

# --- SMTP (email outbox worker) ---
# When running under Docker, secrets may be provided as files and referenced
# with the *_FILE variants (e.g. SMTP_PASS_FILE=/run/secrets/smtp_pass).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
# ADMIN_PASSWORD_HASH_FILE=/run/secrets/admin_hash
# SESSION_SECRET_FILE=/run/secrets/session_secret
# SMTP_USER_FILE=/run/secrets/smtp_user
# SMTP_PASS_FILE=/run/secrets/smtp_pass

# --- Rate limits (per IP) ---
RATE_LIMIT_BOOKING_CREATE=10/minute
RATE_LIMIT_BOOKING_CANCEL=10/minute
RATE_LIMIT_CALENDAR_READ=60/minute
RATE_LIMIT_ADMIN_LOGIN=5/minute

# --- Booking rules ---
BOOKING_CANCELLATION_CUTOFF_MINUTES=5

# --- Email retry policy (exponential back-off) ---
EMAIL_RETRY_BASE_DELAY_SECONDS=60
EMAIL_RETRY_MAX_ATTEMPTS=5
EMAIL_RETRY_MAX_DELAY_SECONDS=960

# --- Observability alerts ---
OBSERVABILITY_ALERT_5XX_RATE=0.01
OBSERVABILITY_ALERT_EMAIL_BACKLOG=100
OBSERVABILITY_ALERT_DB_POOL_EXHAUSTION=true

# --- Runtime ---
AUTO_MIGRATE=true
LOG_LEVEL=INFO
# UI theme: "modern" (current custom UI) or "legacy" (Bootstrap 4.5 look
# matching the old DoES site). Pick at deployment time, not in the UI.
WEB_THEME=modern
